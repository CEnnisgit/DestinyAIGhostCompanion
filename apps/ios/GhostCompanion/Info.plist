<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Ghost Companion</string>
	<!-- Default backend the app talks to. Substituted at build time from the
	     GHOST_BACKEND_URL build setting: localhost in Debug, the production
	     HTTPS endpoint in Release (see apps/ios/project.yml). Users can still
	     override it in Settings. -->
	<key>GhostBackendURL</key>
	<string>$(GHOST_BACKEND_URL)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.cennis.ghostcompanion.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>ghostcompanion</string>
			</array>
		</dict>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>Ghost Companion uses the microphone so you can speak commands to your Ghost instead of typing.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Ghost Companion transcribes your speech to understand your commands. Transcription happens on your device whenever your language supports it.</string>
	<!-- ATS: production is HTTPS. This is the narrowest possible exception — it
	     permits cleartext to `localhost` only, so it grants nothing on a user's
	     device, and it lets a TestFlight/Release build be pointed at a local
	     server for debugging. It is NOT a blanket NSAllowsArbitraryLoads and
	     needs no App Review justification, so it is safe to ship as-is. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
