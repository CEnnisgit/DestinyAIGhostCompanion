# Copy to .env (gitignored) and fill in. Never commit real values.
XAI_API_KEY=
BUNGIE_API_KEY=
BUNGIE_CLIENT_ID=
BUNGIE_CLIENT_SECRET=
BUNGIE_REDIRECT_URI=
GHOST_TOKEN_KEY=
OLLAMA_HOST=
# Flags default off when blank; set to 1 only for the documented opt-in.
GHOST_ALLOW_ENV_AI_KEY=
GHOST_BUNGIE_TOKEN_PROXY=
# Comma-separated trusted frontend origins; defaults include loopback ports 3000/5173.
GHOST_UI_ORIGINS=
