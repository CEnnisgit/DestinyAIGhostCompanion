# Phase 4A: copy to `.env` and fill in real values. NEVER commit a real .env.
# (.env is gitignored.)

# --- Database (matches docker-compose.yml defaults) ---
DATABASE_URL=postgres://ghost:ghost_dev@localhost:5432/ghost_companion
POSTGRES_USER=ghost
POSTGRES_PASSWORD=ghost_dev
POSTGRES_DB=ghost_companion

# --- Bungie API (https://www.bungie.net/en/Application) ---
BUNGIE_API_KEY=your_bungie_api_key_here
BUNGIE_CLIENT_ID=your_bungie_client_id_here
BUNGIE_CLIENT_SECRET=your_bungie_client_secret_here

# --- Generative AI (OpenAI-compatible; ADR-007 allows Ollama/Grok via base URL) ---
OPENAI_API_KEY=your_openai_api_key_here
