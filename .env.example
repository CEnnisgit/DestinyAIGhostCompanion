# Phase 4A: copy to `.env` and fill in real values. NEVER commit a real .env.
# (.env is gitignored.)

# --- Database (matches docker-compose.yml defaults) ---
DATABASE_URL=postgres://ghost:ghost_dev@localhost:5432/ghost_companion
POSTGRES_USER=ghost
POSTGRES_PASSWORD=ghost_dev
POSTGRES_DB=ghost_companion

# --- Bungie API (https://www.bungie.net/en/Application) ---
BUNGIE_API_KEY=your_bungie_api_key_here
BUNGIE_CLIENT_ID=your_bungie_client_id_here
BUNGIE_CLIENT_SECRET=your_bungie_client_secret_here

# --- OAuth callbacks (optional) ---
# Native iOS app: redirect the callback to the app URL scheme.
# GHOST_MOBILE_CALLBACK=ghostcompanion://auth
# Web app: comma-separated allowlist of origins the login may return to.
# GHOST_WEB_CALLBACK=http://localhost:5173,https://your-web-app.example

# --- Generative AI (OpenAI-compatible; ADR-007 allows Ollama/Grok via base URL) ---
OPENAI_API_KEY=your_openai_api_key_here

# --- Sessions / security ---
# Strong random secret used to sign session tokens. REQUIRED in production.
# Generate one with: openssl rand -hex 32
# GHOST_SESSION_SECRET=replace_with_a_long_random_secret
# Set to 1 in production to REQUIRE a valid session on every request and disable
# the membership_id parameter dev fallback. The server refuses to boot with this
# on unless GHOST_SESSION_SECRET is set.
# GHOST_REQUIRE_AUTH=1

# --- Cost control (rate limiting) ---
# `/chat` and `/ws/voice` run a paid LLM tool-calling loop on every turn. These
# cap turns per Guardian: a sustained rate plus a burst allowance. Over budget
# returns 429 with a Retry-After header (the WebSocket replies with an
# `intent: "throttled"` message instead of closing).
# Enforced per process — if you scale past one instance, the effective ceiling
# multiplies by the replica count.
# GHOST_CHAT_RATE_PER_MINUTE=15
# GHOST_CHAT_RATE_BURST=5
