DATABASE_URL=postgres://ghost:ghost_dev@localhost:5433/ghost_companion
BUNGIE_API_KEY=your_bungie_api_key_here
BUNGIE_CLIENT_ID=your_bungie_client_id_here
BUNGIE_CLIENT_SECRET=your_bungie_client_secret_here
OPENAI_API_KEY=your_openai_api_key_here
JWT_SECRET=your_jwt_signing_secret_here
ENCRYPTION_KEY=your_aes256_encryption_passphrase_here

# LLM Configuration (Universal OpenAI Adapter)
# Use https://api.openai.com/v1 for OpenAI, https://api.groq.com/openai/v1 for Groq, http://localhost:11434/v1 for Ollama
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-test-key
LLM_MODEL=gpt-4o-mini

# Optional Fallback LLM (ADR 008)
# FALLBACK_LLM_BASE_URL=http://localhost:11434/v1
# FALLBACK_LLM_API_KEY=ollama
# FALLBACK_LLM_MODEL=llama3
